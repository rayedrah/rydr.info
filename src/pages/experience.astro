---
import Base from '../layouts/Base.astro';
import { EXPERIENCE } from '../data/site.js';

const [first, ...rest] = EXPERIENCE;
---
<Base title="Experience | Rayed Rahman" active="experience">

  {/* the first group ("Now") sits beside the hero, so the list starts at the top */}
  <section class="row" data-object-host>
    <div class="label hero">
      <div>
        <h1 data-tglitch>Experience</h1>
        <span class="sub">Chittagong to Purdue</span>
      </div>
      <canvas class="hero-obj" data-object="computer" data-dot="2" role="img" aria-label="rotating pixel computer"></canvas>
    </div>
    <div class="body">
      <div class="group-head">
        <h2 data-tglitch>{first.group}</h2>
        <p class="sub">Work, research and school, newest first. Click a role to expand it.</p>
      </div>
      <div class="list">
        {first.items.map((e) => (
          <details class="entry" open={e.open}>
            <summary class="item">
              <span class="name">{e.role}</span>
              <span class="lead"></span>
              <span class="meta">{e.date}</span>
            </summary>
            <div class="entry-body">
              <div class="org">{e.org}{e.place && <span style="color: var(--muted)"> · {e.place}</span>}</div>
              {e.text && <p>{e.text}</p>}
              {e.points && <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {rest.map((g) => (
    <section class="row">
      <div class="label"><h2 data-tglitch>{g.group}</h2></div>
      <div class="body list">
        {g.items.map((e) => (
          <details class="entry" open={e.open}>
            <summary class="item">
              <span class="name">{e.role}</span>
              <span class="lead"></span>
              <span class="meta">{e.date}</span>
            </summary>
            <div class="entry-body">
              <div class="org">{e.org}{e.place && <span style="color: var(--muted)"> · {e.place}</span>}</div>
              {e.text && <p>{e.text}</p>}
              {e.points && <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>}
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}

</Base>
