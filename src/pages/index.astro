---
import Base from '../layouts/Base.astro';
import BrainButton from '../components/BrainButton.astro';
import { PROJECTS, EXPERIENCE, LINKS } from '../data/site.js';

const recent = PROJECTS.slice(0, 4);
const now = EXPERIENCE[0].items.slice(0, 4);
---
<Base title="Rayed Rahman | Cybersecurity @ Purdue" active="home" bodyClass="home">

  <section class="intro" id="intro" slot="intro" aria-label="Rayed Rahman">
    <canvas class="intro-grain" aria-hidden="true"></canvas>
    <p class="intro-prompt" aria-hidden="true"><span class="prompt">guest@rydr:~$</span> <span class="intro-cmd"></span><span class="intro-cursor"></span></p>
    <p class="intro-name" aria-hidden="true"><span class="word">RAYED</span> <span class="word">RAHMAN</span></p>
    <div class="scroll-hint" aria-hidden="true"><span>scroll</span><span class="chevron"></span></div>
  </section>

  <section class="row" data-object-host>
    <div class="label hero">
      <div>
        <a class="txt" href="about.html"><h1 data-tglitch>Rayed Rahman</h1></a>
        <a class="sub txt" href="about.html">cybersecurity @ purdue</a>
      </div>
      <a class="obj-link" href="about.html" aria-label="About me"><canvas class="hero-obj" data-object="bolt" data-dot="2" aria-hidden="true"></canvas></a>
    </div>
    <div class="body">
      <p>Salam!</p>
      <p>
        I'm Rayed, a Cybersecurity student at <a href="https://www.purdue.edu/" target="_blank" rel="noopener">Purdue</a>'s
        Honors College. This summer I built the CTF platform for a national cyber drill at
        <a href="experience.html">AGS Quality Action</a>, and before that I worked on deepfake detection at
        <a href="experience.html">GRAIL Lab</a>. I like finding out why systems break under pressure: I'm preparing for CCDC
        with <a href="experience.html">BlueTeam@Purdue</a>, play CTFs with <a href="experience.html">b01lers</a>, and attack
        my own home lab.
      </p>
      <p>
        Find me on <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a>,
        <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>, read my notes on
        <a href="blog/">Brain Log</a>, or email me at <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>.
      </p>
    </div>
  </section>

  <section class="row" data-object-host>
    <div class="label">
      <div class="sec"><a class="obj-link" href="experience.html" aria-label="Experience"><canvas data-object="computer" aria-hidden="true"></canvas></a><div><a class="txt" href="experience.html"><h2 data-tglitch>Now</h2></a><span class="sub"><a class="txt" href="experience.html">All experience</a></span></div></div>
    </div>
    <ul class="body list">
      {now.map((e) => (
        <li class="item">
          <a class="name txt" href="experience.html">{e.role}</a>
          <span class="lead"></span>
          <span class="meta">{e.org}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="row" data-object-host>
    <div class="label">
      <div class="sec"><a class="obj-link" href="projects.html" aria-label="Projects"><canvas data-object="router" aria-hidden="true"></canvas></a><div><a class="txt" href="projects.html"><h2 data-tglitch>Recent Projects</h2></a><span class="sub"><a class="txt" href="projects.html">View all</a></span></div></div>
    </div>
    <ul class="body list">
      {recent.map((p) => (
        <li class="item">
          <a class="name txt" href={`projects.html#${p.id}`}>{p.title}</a>
          <span class="lead"></span>
          <span class="tags">{p.stack.slice(0, 3).map((s) => <span class="tag">{s}</span>)}</span>
        </li>
      ))}
    </ul>
  </section>

  <BrainButton />

  <section class="row" data-object-host>
    <div class="label">
      <div class="sec"><button class="obj-link" type="button" data-focus="termInput" aria-label="Type in the terminal"><canvas data-object="flag" aria-hidden="true"></canvas></button><div><button class="txt plain" type="button" data-focus="termInput"><h2 data-tglitch>Poke Around</h2></button><span class="sub">type 'help'</span></div></div>
    </div>
    <div class="body term">
      <div class="term-log" id="termLog" aria-live="polite">
        <div class="out">guest@rydr connected. type 'help' to look around.</div>
      </div>
      <form class="term-input-row" id="termForm">
        <span class="prompt">~/rayed $</span>
        <input type="text" id="termInput" class="term-input" autocomplete="off" spellcheck="false" aria-label="terminal command" />
      </form>
    </div>
  </section>

</Base>
