---
// Floating brain button that opens Brain Log (the blog).
// A slowly rotating grey brain with a bitmap / halftone texture that now and
// then glitches pink and snaps back (scripts/brain.js), with a brain.log
// label on hover.
---
<a class="brain-btn" href="blog/" aria-label="Brain Log: read my notes">
  <canvas class="brain-canvas" data-brain aria-hidden="true"></canvas>
  <span class="brain-tip" aria-hidden="true">brain.log</span>
</a>

<script>
  import { initBrain } from '../scripts/brain.js';
  initBrain();
</script>

<style>
  .brain-btn {
    position: fixed;
    right: 20px;
    bottom: 18px;
    z-index: 50;
    display: block;
    line-height: 0;
    filter: drop-shadow(2px 2px 0 rgba(0, 0, 0, 0.85));
    animation: brain-in 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2) 1.4s both;
    transition: transform 0.15s ease;
  }
  .brain-btn:hover, .brain-btn:focus-visible { transform: translateY(-3px) scale(1.06); opacity: 1; outline: none; }
  .brain-canvas { display: block; width: 76px; height: 64px; image-rendering: pixelated; }

  /* label slides out to the left on hover */
  .brain-tip {
    position: absolute;
    right: calc(100% + 6px);
    top: 50%;
    transform: translate(6px, -50%);
    padding: 3px 7px;
    font: 11px/1.4 var(--font-mono);
    color: #ff7eb6;
    background: rgba(10, 10, 10, 0.92);
    border: 1px solid #c2457f;
    white-space: nowrap;
    text-shadow: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .brain-btn:hover .brain-tip, .brain-btn:focus-visible .brain-tip { opacity: 1; transform: translate(0, -50%); }

  @keyframes brain-in { from { opacity: 0; translate: 0 18px; } to { opacity: 1; translate: 0 0; } }

  @media (max-width: 600px) {
    .brain-btn { right: 10px; bottom: 10px; }
    .brain-canvas { width: 62px; height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .brain-btn { animation: none; }
  }
</style>
